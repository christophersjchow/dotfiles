#!/bin/sh

set -eu

umask 077

stable_socket=${SSH_AGENT_STABLE_SOCK:-"$HOME/.ssh/agent/current"}
local_socket=${SSH_AGENT_LOCAL_SOCK:-"$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"}

show_status() {
  target=$(readlink "$stable_socket" 2>/dev/null || true)

  printf 'SSH_AUTH_SOCK=%s\n' "${SSH_AUTH_SOCK:-<unset>}"
  printf 'stable=%s\n' "$stable_socket"
  printf 'target=%s\n' "${target:-<unset>}"

  if [ -S "$stable_socket" ]; then
    SSH_AUTH_SOCK=$stable_socket ssh-add -l
  else
    printf 'No live agent is available through the stable socket.\n' >&2
    return 1
  fi
}

if [ "${1:-}" = "--status" ]; then
  show_status
  exit
fi

source_socket=
for candidate in "${1:-}" "${SSH_AGENT_SOURCE_SOCK:-}" "${SSH_AUTH_SOCK:-}"; do
  if [ -n "$candidate" ] && [ "$candidate" != "$stable_socket" ] && [ -S "$candidate" ]; then
    source_socket=$candidate
    break
  fi
done

if [ -z "$source_socket" ] && [ -z "${SSH_CONNECTION:-}" ] && [ -S "$local_socket" ]; then
  source_socket=$local_socket
fi

if [ -z "$source_socket" ]; then
  printf 'No live SSH agent source socket was found.\n' >&2
  exit 1
fi

socket_directory=$(dirname "$stable_socket")
if [ ! -d "$socket_directory" ]; then
  mkdir -p "$socket_directory"
  chmod 700 "$socket_directory"
fi

if [ -e "$stable_socket" ] && [ ! -L "$stable_socket" ]; then
  printf 'Refusing to replace non-symlink path: %s\n' "$stable_socket" >&2
  exit 1
fi

temporary_link="${stable_socket}.tmp.$$"
cleanup() {
  if [ -L "$temporary_link" ]; then
    unlink "$temporary_link"
  fi
}
trap cleanup EXIT HUP INT TERM

ln -s "$source_socket" "$temporary_link"
mv -f "$temporary_link" "$stable_socket"
trap - EXIT HUP INT TERM

printf '%s\n' "$stable_socket"
